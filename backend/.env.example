# Copy to backend/.env for local runs.

# Cleaned FastText vectors (see README → "Векторлар")
VECTORS_PATH=../data/wiki.kk.clean.vec
# Fast numpy cache, rebuilt automatically when the .vec file changes
CACHE_PATH=../data/kk_vectors.npz

# 1 = use random vectors when the .vec file is missing (UI work only!)
ALLOW_DUMMY_VECTORS=1

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Signs custom-game links. Use a long random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# The daily word switches at local midnight (Kazakhstan = UTC+5)
DAY_UTC_OFFSET_HOURS=5
